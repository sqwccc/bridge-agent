# Build context is generated by scripts/build-cce-offline.ps1; contains no credentials.
FROM eclipse-temurin:25-jre-alpine
USER root
RUN apk add --no-cache nginx bash tini \
    && addgroup -g 10001 -S bridgemind \
    && adduser -u 10001 -S -G bridgemind bridgemind \
    && mkdir -p /app/html
WORKDIR /app
COPY application.jar /app/application.jar
COPY html/ /app/html/
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod 755 /app/entrypoint.sh
ENV SPRING_PROFILES_ACTIVE=prod,cce \
    TZ=Asia/Shanghai \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0"
USER 10001:10001
EXPOSE 18089
STOPSIGNAL SIGTERM
ENTRYPOINT ["/sbin/tini", "--", "/app/entrypoint.sh"]
