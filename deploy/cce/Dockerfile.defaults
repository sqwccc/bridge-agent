# Private image only: the supplied context includes production credentials.
ARG BASE_IMAGE=bridgemind:20261028-cce
FROM ${BASE_IMAGE}
USER root
COPY production-defaults.env /app/production-defaults.env
COPY defaults-entrypoint.sh /app/defaults-entrypoint.sh
RUN chown 10001:10001 /app/production-defaults.env \
    && chmod 400 /app/production-defaults.env \
    && chmod 755 /app/defaults-entrypoint.sh
USER 10001:10001
ENTRYPOINT ["/sbin/tini", "--", "/app/defaults-entrypoint.sh"]
