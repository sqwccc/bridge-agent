# 复制为 .env，填写已有数据库的连接和独立账号；生产不使用本地初始化脚本。
APP_DB_URL=jdbc:postgresql://host.docker.internal:5432/bridgemind
APP_DB_USER=bridgemind_app
APP_DB_PASSWORD=replace-with-production-password
APP_DB_SCHEMA=public
SOURCE_DB_URL=jdbc:postgresql://source-db.internal:5432/source_database
SOURCE_DB_USER=replace-with-select-only-user
SOURCE_DB_PASSWORD=replace-with-source-password
SOURCE_DB_SCHEMA=qiaoliang
# 允许访问的附件地址前缀，例如 https://files.internal/qiaoliang/
REPORT_BASE_URL=
# 仅绑定回环，外层 HTTPS 网关反代此端口。
WEB_PORT=8089
# Internal Dify application API; model credentials are configured inside Dify.
DIFY_BASE_URL=http://dify.internal/v1
DIFY_API_KEY=
DIFY_DATA_MODE=source
DIFY_PREVIEW_ACCESS=false
